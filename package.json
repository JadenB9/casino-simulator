{
  "name": "casino-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D casino you walk around in, with real Las Vegas rules, real odds, and other people.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run --project unit --project worker",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:mc": "vitest run --project montecarlo",
    "test:all": "vitest run",
    "typecheck": "npm run types && tsc -p shared && tsc -p server && tsc -p client",
    "types": "wrangler types -c server/wrangler.toml server/worker-configuration.d.ts",
    "privacy": "node scripts/privacy.mjs",
    "postinstall": "npm run types"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.3",
    "@gltf-transform/cli": "4.5.0",
    "@types/three": "0.186.0",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
